class Solution {
public:
    int n;
    unordered_map<string,bool>mp;

    bool solve(string s,unordered_set<string>&st){
              if(st.count(s)) 
                 return true;

            if(mp.count(s))
               return mp[s];

            for(int i= 0;i<n;i++){

                string sub_str = s.substr(0,i);
                
                if(st.count(sub_str) && solve(s.substr(i),st)){
                    return mp[s] = true  ;
                }
              
            }     
        return mp[s] =  false;    
    }
    bool wordBreak(string s, vector<string>& wordDict) {
         n = s.length();
        unordered_set<string>st(begin(wordDict),end(wordDict));

        return solve(s,st);

        
    }
};



// mik code 

class Solution {
public:
    int n;
    int t[301];

    bool solve(string s,unordered_set<string>&st,int idx){
              if(idx>=n || st.count(s)) 
                 return true;

            if(t[idx] != -1)
               return t[idx];

            for(int i= 1;i<=n;i++){

                string sub_str = s.substr(idx,i);
                
                if(st.count(sub_str) && solve(s,st,idx+i)){
                    return t[idx] = true  ;
                }
              
            }     
        return t[idx] =  false;    
    }
    bool wordBreak(string s, vector<string>& wordDict) {
         n = s.length();
        unordered_set<string>st(begin(wordDict),end(wordDict));
        
        memset(t,-1,sizeof(t));

        return solve(s,st,0);

        
    }
};
